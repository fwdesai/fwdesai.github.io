---
import ImagePlaceholder from './ImagePlaceholder.astro';

// `slides` is [{ src, alt, caption }]. Built in [slug].astro so the project's
// cover photo is always slide one — see the comment there.
const { slides = [], slug } = Astro.props;
const multiple = slides.length > 1;
---

{
  slides.length === 0 ? (
    <ImagePlaceholder
      class="aspect-[4/3] w-full rounded-lg"
      label={`Add photos to public/images/projects/${slug}/`}
    />
  ) : (
    <div class="carousel" data-carousel>
      <div class="viewport">
        <ul
          class="track"
          data-track
          tabindex="0"
          role="group"
          aria-roledescription="carousel"
          aria-label={`${slides.length} project ${slides.length === 1 ? 'photo' : 'photos'}`}
        >
          {slides.map((slide, i) => (
            <li
              class="slide"
              data-caption={slide.caption ?? ''}
              role="group"
              aria-roledescription="slide"
              aria-label={`${i + 1} of ${slides.length}`}
            >
              <img
                src={slide.src}
                alt={slide.alt}
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </li>
          ))}
        </ul>

        {multiple && (
          <>
            <button type="button" class="arrow prev" data-prev aria-label="Previous photo">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M15 5l-7 7 7 7" />
              </svg>
            </button>
            <button type="button" class="arrow next" data-next aria-label="Next photo">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M9 5l7 7-7 7" />
              </svg>
            </button>
          </>
        )}
      </div>

      {/* Rendered server-side with the first slide's caption so it is correct
          before the script runs, then kept in sync as slides change. */}
      <p class="caption" data-caption-out>{slides[0].caption ?? ''}</p>

      {multiple && (
        <div class="dots" data-dots>
          {slides.map((_, i) => (
            <button
              type="button"
              data-dot={i}
              aria-current={i === 0 ? 'true' : 'false'}
              aria-label={`Go to photo ${i + 1}`}
            />
          ))}
        </div>
      )}
    </div>
  )
}

<style>
  .viewport {
    position: relative;
  }

  /* Native horizontal snap scrolling. Swipe works on touch with no JS at all;
     the script below only adds the arrows, dots, and caption sync. */
  .track {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    border-radius: 0.5rem;
  }
  .track::-webkit-scrollbar {
    display: none;
  }

  .slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    scroll-snap-stop: always;
  }

  /* object-fit: contain so a board photo is never cropped. The tinted box
     absorbs whatever aspect ratio the photo happens to be. */
  .slide img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: contain;
    background-color: var(--color-tint);
    border: 1px solid var(--color-rule);
    border-radius: 0.5rem;
  }

  .arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 9999px;
    border: 1px solid var(--color-rule);
    background-color: color-mix(in srgb, var(--color-paper) 88%, transparent);
    color: var(--color-ink);
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
  }
  .arrow:hover {
    background-color: var(--color-paper);
    color: var(--color-accent);
  }
  .arrow svg {
    width: 1.25rem;
    height: 1.25rem;
  }
  .prev {
    left: 0.75rem;
  }
  .next {
    right: 0.75rem;
  }

  .caption {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--color-muted);
    min-height: 1.25rem;
  }

  .dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .dots button {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background-color: var(--color-rule);
    cursor: pointer;
    transition: background-color 0.15s;
  }
  .dots button[aria-current='true'] {
    background-color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  document.querySelectorAll('[data-carousel]').forEach((root) => {
    const track = root.querySelector('[data-track]');
    const slides = Array.from(track?.children ?? []);
    if (!track || slides.length < 2) return;

    const captionOut = root.querySelector('[data-caption-out]');
    const dots = Array.from(root.querySelectorAll('[data-dot]'));
    const captions = slides.map((s) => s.dataset.caption ?? '');
    let index = 0;

    function render(i) {
      index = i;
      dots.forEach((dot, n) =>
        dot.setAttribute('aria-current', n === i ? 'true' : 'false')
      );
      if (captionOut) captionOut.textContent = captions[i];
    }

    function goTo(i) {
      // Wrap around at both ends.
      const target = (i + slides.length) % slides.length;
      track.scrollTo({ left: slides[target].offsetLeft - track.offsetLeft });
    }

    root.querySelector('[data-prev]')?.addEventListener('click', () => goTo(index - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => goTo(index + 1));
    dots.forEach((dot, n) => dot.addEventListener('click', () => goTo(n)));

    track.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') {
        event.preventDefault();
        goTo(index - 1);
      } else if (event.key === 'ArrowRight') {
        event.preventDefault();
        goTo(index + 1);
      }
    });

    // Derive the active slide from scroll position, so swiping keeps the dots
    // and caption honest.
    let settle;
    track.addEventListener(
      'scroll',
      () => {
        clearTimeout(settle);
        settle = setTimeout(() => {
          const i = Math.round(track.scrollLeft / track.clientWidth);
          if (i !== index && slides[i]) render(i);
        }, 60);
      },
      { passive: true }
    );

    render(0);
  });
</script>
