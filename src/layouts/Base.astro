---
import '../styles/global.css';
import { SITE, NAV } from '../data/site.js';

const { title, description = SITE.description, wide = false } = Astro.props;

const pageTitle = title ? `${title} — ${SITE.name}` : `${SITE.name} — ${SITE.role}`;
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Social preview -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body class="flex min-h-screen flex-col">
    <!-- Skip link for keyboard and screen-reader users -->
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
    >
      Skip to content
    </a>

    <header class="border-b border-rule">
      <div
        class={`mx-auto flex w-full items-center justify-end gap-6 px-6 py-5 ${wide ? 'max-w-6xl' : 'max-w-3xl'}`}
      >
        <nav aria-label="Main">
          <ul class="flex flex-wrap items-center justify-end gap-x-4 gap-y-1 text-sm sm:gap-x-7">
            {
              NAV.map((item) => {
                const isActive =
                  item.href === '/'
                    ? currentPath === '/'
                    : currentPath.startsWith(item.href);
                return (
                  <li>
                    <a
                      href={item.href}
                      aria-current={isActive ? 'page' : undefined}
                      class={`transition-colors hover:text-accent ${
                        isActive
                          ? 'font-medium text-ink underline decoration-accent decoration-2 underline-offset-6'
                          : 'text-muted'
                      }`}
                    >
                      {item.label}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="flex-1">
      <div class={`mx-auto w-full px-6 py-12 sm:py-16 ${wide ? 'max-w-6xl' : 'max-w-3xl'}`}>
        <slot />
      </div>
    </main>

    <footer class="border-t border-rule">
      <div
        class={`mx-auto flex w-full flex-col gap-2 px-6 py-8 text-sm text-muted sm:flex-row sm:items-center sm:justify-between ${wide ? 'max-w-6xl' : 'max-w-3xl'}`}
      >
        <p>© {new Date().getFullYear()} {SITE.name}</p>
        <a
          href={`mailto:${SITE.email}`}
          class="text-accent underline underline-offset-2 hover:decoration-2"
        >
          {SITE.email}
        </a>
      </div>
    </footer>
  </body>
</html>
