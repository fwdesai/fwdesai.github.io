---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <h1 class="text-4xl leading-tight">Page not found</h1>
  <p class="mt-4 text-lg">
    That page doesn't exist. Try the <a
      href="/"
      class="text-accent underline underline-offset-4 hover:decoration-2">home page</a
    > or <a
      href="/projects"
      class="text-accent underline underline-offset-4 hover:decoration-2">projects</a
    >.
  </p>
</Base>
