---
import Base from '../../layouts/Base.astro';
import Carousel from '../../components/Carousel.astro';
import Prose from '../../components/Prose.astro';
import { projects } from '../../data/projects.js';

// One page is generated per entry in src/data/projects.js — no new file needed
// when you add a project.
export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

// The cover photo always leads the carousel, so the detail page opens on the
// same image the grid card showed. Listing the cover in `images` too is
// harmless — duplicates are dropped by src.
const slides = [
  ...(project.cover ? [{ src: project.cover, alt: project.title, caption: '' }] : []),
  ...project.images,
].filter((slide, i, all) => all.findIndex((s) => s.src === slide.src) === i);

// Personal projects may carry no org or dates.
const meta = [project.org, project.period].filter(Boolean).join(' · ');
---

<Base title={project.title} description={project.summary}>
  <a
    href="/projects"
    class="mb-8 inline-block text-sm text-muted transition-colors hover:text-accent"
  >
    ← All projects
  </a>

  <header class="mb-10">
    {
      meta && (
        <p class="mb-2 font-mono text-xs tracking-wide text-muted uppercase">{meta}</p>
      )
    }

    <h1 class="text-4xl leading-tight">{project.title}</h1>
    {project.subtitle && <p class="mt-3 text-lg text-muted">{project.subtitle}</p>}

    {
      project.links?.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2">
          {project.links.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener"
                class="text-sm text-accent underline underline-offset-4 hover:decoration-2"
              >
                {link.label} ↗
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </header>

  <div class="mb-12">
    <Carousel slides={slides} slug={project.slug} />
  </div>

  <Prose sections={project.sections} />
</Base>
