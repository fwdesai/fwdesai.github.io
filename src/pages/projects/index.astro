---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects.js';
---

<Base
  wide
  title="Selected Projects"
  description="Hardware and embedded systems projects — high-speed PCB design, analog front-ends, and firmware."
>
  <!-- Full width, not max-w-3xl, so the heading's left edge lines up with
       the first card in the grid below. -->
  <header class="mb-12">
    <h1 class="text-4xl leading-tight">Selected Projects</h1>
  </header>

  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>
</Base>
