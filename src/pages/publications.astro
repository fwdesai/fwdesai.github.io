---
import Base from '../layouts/Base.astro';
import { publications, SELF_NAMES } from '../data/publications.js';

// Split an author list into runs so Finley's name can be emphasized without
// putting markup in the data file.
function authorParts(authors = []) {
  return authors.map((name, i) => ({
    name,
    isSelf: SELF_NAMES.includes(name),
    separator: i < authors.length - 1 ? ', ' : '',
  }));
}
---

<Base title="Publications" description="Papers, abstracts, and posters by Finley Desai.">
  <header class="mb-10">
    <h1 class="text-4xl leading-tight">Publications</h1>
  </header>

  {
    publications.length === 0 ? (
      <p class="text-muted">Nothing here yet.</p>
    ) : (
      <ul class="divide-y divide-rule border-t border-b border-rule">
        {publications.map((pub) => (
          <li class="py-5">
            <p class="mb-1.5 font-mono text-xs tracking-wide text-muted uppercase">{pub.type}</p>
            <h2 class="text-lg leading-snug">
              {pub.href ? (
                <a
                  href={pub.href}
                  target="_blank"
                  rel="noopener"
                  class="transition-colors hover:text-accent"
                >
                  {pub.title}
                </a>
              ) : (
                pub.title
              )}
            </h2>

            {pub.authors?.length > 0 && (
              <p class="mt-1.5 text-sm leading-relaxed">
                {authorParts(pub.authors).map((a) =>
                  a.isSelf ? (
                    <>
                      <strong class="font-medium text-ink">{a.name}</strong>
                      {a.separator}
                    </>
                  ) : (
                    a.name + a.separator
                  )
                )}
              </p>
            )}

            {pub.venue && <p class="mt-1 text-sm text-muted">{pub.venue}</p>}

            {pub.href && (
              <a
                href={pub.href}
                target="_blank"
                rel="noopener"
                class="mt-1.5 inline-block text-sm text-accent underline underline-offset-4 hover:decoration-2"
              >
                {pub.linkLabel ?? 'Link'} ↗
              </a>
            )}

            {/* Related items — the poster or abstract that goes with this
                paper. Indented under a rule so the group reads as one piece
                of work. */}
            {pub.related?.length > 0 && (
              <ul class="mt-4 space-y-4 border-l-2 border-rule pl-4 sm:pl-5">
                {pub.related.map((item) => (
                  <li>
                    <p class="mb-1 font-mono text-xs tracking-wide text-muted uppercase">
                      {item.type}
                    </p>
                    <h3 class="text-base leading-snug">
                      {item.href ? (
                        <a
                          href={item.href}
                          target="_blank"
                          rel="noopener"
                          class="transition-colors hover:text-accent"
                        >
                          {item.title}
                        </a>
                      ) : (
                        item.title
                      )}
                    </h3>

                    {item.authors?.length > 0 && (
                      <p class="mt-1 text-sm leading-relaxed">
                        {authorParts(item.authors).map((a) =>
                          a.isSelf ? (
                            <>
                              <strong class="font-medium text-ink">{a.name}</strong>
                              {a.separator}
                            </>
                          ) : (
                            a.name + a.separator
                          )
                        )}
                      </p>
                    )}

                    {item.venue && <p class="mt-1 text-sm text-muted">{item.venue}</p>}

                    {item.href && (
                      <a
                        href={item.href}
                        target="_blank"
                        rel="noopener"
                        class="mt-1 inline-block text-sm text-accent underline underline-offset-4 hover:decoration-2"
                      >
                        {item.linkLabel ?? 'Link'} ↗
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
    )
  }
</Base>
