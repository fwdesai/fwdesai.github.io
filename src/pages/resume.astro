---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site.js';
---

<Base
  title="Resume"
  description={`Resume for ${SITE.name} — electrical engineering, Stanford.`}
>
  <header class="mb-8">
    <h1 class="text-4xl leading-tight">Resume</h1>

    <div class="mt-6 flex flex-wrap gap-3">
      {/* Top-level navigation to the PDF. This is deliberately a plain link
           with NO `download` attribute: it opens the browser's own full-screen
           PDF viewer, which is the one path that works well on both iOS
           Safari and Chrome on Android. */}
      <a
        href={SITE.resumePdf}
        target="_blank"
        rel="noopener"
        class="rounded-md bg-ink px-5 py-2.5 text-sm font-medium text-paper transition-opacity hover:opacity-85"
      >
        Open PDF ↗
      </a>
      <a
        href={SITE.resumePdf}
        download
        class="rounded-md border border-rule px-5 py-2.5 text-sm font-medium text-ink transition-colors hover:border-accent hover:text-accent"
      >
        Download
      </a>
    </div>
  </header>

  {/* The in-page preview is a rendered image of the PDF rather than an
       <iframe>. Embedded PDFs are unreliable on mobile — iOS Safari renders a
       frozen, unscrollable first page and Chrome on Android often shows
       nothing at all in a subframe. The image always works; the buttons above
       hand off to a real PDF viewer for anyone who wants text selection. */}
  <figure>
    <a href={SITE.resumePdf} target="_blank" rel="noopener" class="block">
      <img
        src={SITE.resumeImage}
        alt={`Resume for ${SITE.name}. Use the Open PDF button above for a selectable-text version.`}
        width="1529"
        height="1980"
        class="w-full rounded-lg border border-rule shadow-sm"
      />
    </a>
    <figcaption class="mt-3 text-sm text-muted">
      Preview image — open the PDF above for selectable text.
    </figcaption>
  </figure>
</Base>
